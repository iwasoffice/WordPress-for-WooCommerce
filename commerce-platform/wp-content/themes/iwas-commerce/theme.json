{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "760px", "wideSize": "1240px"},
    "color": {
      "palette": [
        {"slug": "ink", "name": "Ink", "color": "#17131d"},
        {"slug": "paper", "name": "Paper", "color": "#fbfaf8"},
        {"slug": "accent", "name": "Accent", "color": "#6f46d8"},
        {"slug": "accent-2", "name": "Accent 2", "color": "#9b72ff"},
        {"slug": "muted", "name": "Muted", "color": "#6f6978"}
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "slug": "sans", "name": "Sans"}
      ]
    }
  },
  "styles": {
    "typography": {"fontFamily": "var(--wp--preset--font-family--sans)"},
    "spacing": {"blockGap": "1.5rem"}
  }
}
